# 本机联调专用模式：npm run build:local（vite build --mode localapi）
# 产物接口指向开发机的 node 服务（默认 3000 端口，若 .env 改了 PORT 需同步）。
# 必须用局域网 IP 而非 localhost：接口地址会被编译进 JS，
# localhost 会被解析成访问者自己的电脑，只有本机浏览器能连到开发机服务。
# 调试产物请在本地访问（npx serve dist），勿上传服务器覆盖线上包。
# 恢复线上：重新执行 npm run build（同源 /api 由 Nginx 反代）。
VITE_ENV=production
VITE_API_BASE_URL=http://192.168.3.24:3000

# 高德地图
VITE_AMAP_KEY=7bcf86baa19394704350e027981a1065
VITE_AMAP_SECURITY_CODE=397b2b3a17f236fdfa0cd77fd16e19bd
